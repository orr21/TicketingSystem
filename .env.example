# Copy to .env for local development (make run does this automatically).
# The Databricks Apps runtime injects real PG* values + LAKEBASE_ENDPOINT, so
# these only take effect when running the app locally.

# Local Postgres (docker-compose.yml) — host port 5433 to avoid conflicts
PGHOST=localhost
PGPORT=5433
PGDATABASE=ticketing
PGUSER=postgres
PGPASSWORD=postgres
PGSSLMODE=disable

# Identity used for created_by/messages in local dev (no Databricks auth needed)
DEV_USER=dev@example.com
